# Local development only — do NOT commit .env to git
#
# On Databricks:
#   - Sensitive values (SLACK_WEBHOOK_URL, PYPI_TOKEN): store in Databricks Secrets
#     and read with dbutils.secrets.get(scope="...", key="...")
#   - Non-sensitive values (NECO_DQ_PROFILE, DQ_ENVIRONMENT, NECO_DQ_VERBOSE):
#     set as Environment Variables in the Job or Cluster configuration
#     (Job settings > Advanced > Environment variables)

# ── Runtime ────────────────────────────────────────────────
# Active profile (dev | staging | prod). Can also be passed via run_dq(profile=...)
# On Databricks: Job/Cluster environment variable
NECO_DQ_PROFILE=dev

# Enable verbose output for the Great Expectations suite (0 = off, 1 = on)
# Useful for local debugging; keep 0 in production to avoid noisy job logs
# On Databricks: Job/Cluster environment variable
NECO_DQ_VERBOSE=0

# ── Slack alerts ───────────────────────────────────────────
# Incoming webhook URL for DQ run summaries
# https://api.slack.com/messaging/webhooks
# On Databricks: recommended via Databricks Secrets (dbutils.secrets.get),
# but can also be set as a Job/Cluster environment variable
SLACK_WEBHOOK_URL=

# Environment label shown in Slack notifications (e.g. dev, staging, prod)
# On Databricks: Job/Cluster environment variable
DQ_ENVIRONMENT=dev

# ── Publishing (maintainers only) ─────────────────────────
# PyPI API token for publishing neco-dq-framework
# https://pypi.org/manage/account/token/
# Used locally (uv publish) or via GitHub Actions secret — not needed on Databricks
PYPI_TOKEN=
